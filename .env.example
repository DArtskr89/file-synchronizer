# Полный путь к локальной папке. На Windows используйте прямые слеши.
LOCAL_FOLDER=C:/Users/YourName/Documents/sync_folder

# Папка на Яндекс Диске. Если её нет, программа создаст её.
CLOUD_FOLDER=backup

# OAuth-токен Яндекс Диска. Никому его не показывайте.
YANDEX_TOKEN=your_token_here

# Период синхронизации в секундах.
SYNC_INTERVAL=10

# Файл, в который будут записываться логи.
LOG_FILE=logs/synchronizer.log
